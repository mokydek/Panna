{
  "name": "Panna Football",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "PannaShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "PannaServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "PannaClient": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.0,
        "Brightness": 2.8,
        "ExposureCompensation": 0.08,
        "Ambient": [0.6352941176, 0.6705882353, 0.7215686275],
        "OutdoorAmbient": [0.7450980392, 0.7921568627, 0.8392156863],
        "EnvironmentDiffuseScale": 0.72,
        "EnvironmentSpecularScale": 0.18,
        "GlobalShadows": false,
        "ShadowSoftness": 0.3
      },
      "PannaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Density": 0.06,
          "Offset": 0.1,
          "Color": [0.8784313725, 0.9333333333, 0.9803921569],
          "Decay": [0.6901960784, 0.7686274510, 0.8235294118],
          "Glare": 0.0,
          "Haze": 0.15
        }
      },
      "PannaColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Brightness": 0.01,
          "Contrast": 0.02,
          "Saturation": 0.08,
          "TintColor": [1.0, 1.0, 1.0]
        }
      },
      "PannaSoftBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": false,
          "Intensity": 0.0,
          "Size": 12,
          "Threshold": 2.0
        }
      },
      "PannaSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": false,
          "Intensity": 0.0,
          "Spread": 0.65
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "FallenPartsDestroyHeight": -100
      },
      "PannaDistrict": {
        "$path": "src/world/PannaDistrict.model.json"
      },
      "PannaDetailedAssets": {
        "$path": "src/world/PannaBrightBlockKit.model.json"
      }
    }
  }
}
