{
  "name": "Panna Football",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "PannaShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "PannaServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "PannaClient": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.15,
        "Brightness": 3.0,
        "ExposureCompensation": 0.18,
        "Ambient": [0.5647058824, 0.6196078431, 0.6823529412],
        "OutdoorAmbient": [0.6901960784, 0.7450980392, 0.8039215686],
        "EnvironmentDiffuseScale": 0.72,
        "EnvironmentSpecularScale": 0.5,
        "GlobalShadows": true,
        "ShadowSoftness": 0.55
      },
      "PannaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Density": 0.18,
          "Offset": 0.2,
          "Color": [0.7803921569, 0.8823529412, 1.0],
          "Decay": [0.4745098039, 0.6156862745, 0.7450980392],
          "Glare": 0.06,
          "Haze": 0.65
        }
      },
      "PannaColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Brightness": 0.04,
          "Contrast": 0.06,
          "Saturation": 0.08,
          "TintColor": [1.0, 0.9725490196, 0.9215686275]
        }
      },
      "PannaNeonBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Intensity": 0.12,
          "Size": 18,
          "Threshold": 1.4
        }
      },
      "PannaSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Intensity": 0.035,
          "Spread": 0.72
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "FallenPartsDestroyHeight": -100
      },
      "PannaDistrict": {
        "$path": "src/world/PannaDistrict.model.json"
      }
    }
  }
}
