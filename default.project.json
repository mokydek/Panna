{
  "name": "Panna Football",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "PannaShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "PannaServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "PannaClient": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 13.8,
        "Brightness": 2.65,
        "ExposureCompensation": 0.05,
        "Ambient": [0.5372549020, 0.5803921569, 0.5568627451],
        "OutdoorAmbient": [0.6627450980, 0.7098039216, 0.6823529412],
        "EnvironmentDiffuseScale": 0.8,
        "EnvironmentSpecularScale": 0.35,
        "GlobalShadows": true,
        "ShadowSoftness": 0.45
      },
      "PannaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Density": 0.12,
          "Offset": 0.15,
          "Color": [0.8117647059, 0.8784313725, 0.9254901961],
          "Decay": [0.5686274510, 0.6549019608, 0.6823529412],
          "Glare": 0.02,
          "Haze": 0.4
        }
      },
      "PannaColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Brightness": 0.01,
          "Contrast": 0.04,
          "Saturation": 0.02,
          "TintColor": [1.0, 0.9882352941, 0.9607843137]
        }
      },
      "PannaSoftBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Intensity": 0.04,
          "Size": 12,
          "Threshold": 2.0
        }
      },
      "PannaSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Attributes": {
            "PannaDistrictBuilderEffect": { "Bool": true }
          },
          "Enabled": true,
          "Intensity": 0.025,
          "Spread": 0.65
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "FallenPartsDestroyHeight": -100
      },
      "PannaDistrict": {
        "$path": "src/world/PannaDistrict.model.json"
      }
    }
  }
}
